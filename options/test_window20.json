{
    "task": "AvatarPoseEstimation_window20"
    , "model": "avatarposer"
    , "gpu_ids": [0]

    , "merge_bn": true
    , "merge_bn_startpoint": 400000

    , "path": {
      "root": "results"
      , "pretrained_netG": "model_zoo/avatarposer.pth"
    }
    , "support_dir": "support_data/"
    , "datasets": {
      "train": {
        "name": "train_dataset"
        , "dataset_type": "amass"
        , "dataroot": "./data_cameraready_fps60"
        , "dataloader_shuffle": true
        , "dataloader_num_workers": 16
        , "dataloader_batch_size": 256
        , "num_input": 3
        , "window_size": 20
      },
      "test": {
        "name": "test_dataset"
        , "dataset_type": "amass"
        , "dataroot": "./data_cameraready_fps60"
        , "dataloader_batch_size": 1
        , "num_input": 3
        , "window_size": 20
      }
    }

    , "netG": {
      "net_type": "AvatarPoser"
      , "num_layer": 3
      , "input_dim": 54
      , "output_dim": 132
      , "embed_dim": 256
      , "nhead": 8
      , "init_type": "kaiming_normal"
      , "init_bn_type": "uniform"
      , "init_gain": 0.2
    }

    , "train": {
      "G_lossfn_type": "l1"
      , "G_lossfn_weight": 1.0
      , "G_optimizer_type": "adam"
      , "G_optimizer_lr": 1e-4
      , "G_optimizer_clipgrad": null
      , "G_scheduler_type": "MultiStepLR"
      , "G_scheduler_milestones": [60000, 120000, 180000, 240000, 300000, 360000]
      , "G_scheduler_gamma": 0.5
      , "G_regularizer_orthstep": null
      , "G_regularizer_clipstep": null
      , "checkpoint_test": 10000
      , "checkpoint_save": 10000
      , "checkpoint_print": 500
    }
  }
