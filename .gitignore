support_data/body_models
# results/ is ignored EXCEPT results/baselines/*.json (small, valuable eval-result summaries that
# results_comparison.md cites by path -- everything else under results/, e.g. model checkpoint
# dirs like AvatarPoseEstimationQuest2/, stays ignored). Needs the parent-dir re-include dance --
# a plain `!results/baselines/*.json` alone wouldn't work, since gitignore prunes an excluded
# directory's contents before ever checking negation patterns against paths inside it.
results/*
!results/baselines/
results/baselines/*
!results/baselines/*.json
*.pkl
*fps60
**/__pycache__
amass/
support_data/

# data/ holds the heavy datasets (quest2_synthetic/ alone is ~300G) alongside the dataset loader
# modules, so ignore the contents but re-include the top-level .py files -- a bare `data/` would
# silently swallow any new loader added here.
data/*
!data/*.py

# experiment outputs -- the blanket output/ subsumes the per-run rules that used to live here
# (phc_*/, quest_distill_*/, .recovery_logs/, renderings/, states/, blender_renders/).
output/
results_*/
model_zoo/*.pth
